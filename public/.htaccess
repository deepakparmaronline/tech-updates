RewriteEngine On
# Preserve all existing date-based article URLs after the public URL migration.
# Example: /articles/2026-09-30-chatgpt-memory-disappeared/ -> /articles/chatgpt-memory-disappeared/
RewriteRule ^articles/[0-9]{4}-[0-9]{2}-[0-9]{2}-(.+)/?$ /articles/$1/ [R=301,L,NE]

# Permanently redirect the legacy Base44 alternatives URL to its canonical article URL.
RewriteRule ^base44-alternatives/?$ /articles/base44-alternatives/ [R=301,L,NE]
